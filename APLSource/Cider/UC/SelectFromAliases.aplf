 r←{caption}SelectFromAliases data;row
 r←⍬
 caption←{0<⎕NC ⍵:⍎⍵ ⋄ ''}'caption'
 :If 0=≢data
     data←P.GetCiderAliasFileContent ⍬
 :EndIf
 :If 0<≢data
     data[;1]←{'[',⍵,']'}¨data[;1]
     caption←'Select project to be opened',({0=≢⍵:⍵ ⋄ ' ',⍵,' '}caption),':'
     row←'SelecProject@Select project to be opened:'P.##.CommTools.Select↓⎕FMT data
     :If ¯1≢row
     :AndIf ⍬≢row
         r←row⊃data[;2]
     :EndIf
 :EndIf
