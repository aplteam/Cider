 (successFlag msg)←PerformConfigChecks config;namespace;path;tatinFolder;this;report;buff
 successFlag←⍬
 report←''
 :For this :In 'dependencies' 'dependencies_dev'
     :If 0=≢tatinFolder←this GetTatinDependencies config
         :Continue
     :EndIf
     :If '='∊tatinFolder
         buff←'='(≠⊆⊢)tatinFolder
         :If (2≠≢buff)∨1≠'='+.=tatinFolder
             ⍝ Anything but exactly <folder>=<namespace> is invalid
             successFlag,←FAILURE
             report,←⊂'Something is wrong with "',this,'" (',tatinFolder,'); expected <folder>=<namespace>'
         :Else
             (path namespace)←buff
             successFlag,←(1+0=(⎕NS'').{⎕NC ⍵}namespace)⊃FAILURE SUCCESS
             :If 0=¯1↑successFlag
                 report,←⊂'Something is wrong with "',this,'" (',tatinFolder,')'
             :EndIf
         :EndIf
     :ElseIf ~','∊tatinFolder
         successFlag,←SUCCESS
     :Else
              ⍝ More than one is invalid
         successFlag,←FAILURE
         report,←⊂'Something is wrong with "',this,'"'
     :EndIf
 :EndFor
 :If 0=config.CIDER.⎕NC'make'
     successFlag,←FAILURE
     report,←⊂'"CIDER.make" is not defined'
 :Else
     :If (⊃config.CIDER.make)∊'#⎕'
         successFlag,←FAILURE
         report,←⊂'"CIDER.make" is defined with an absolute path; must be relative to the project'
     :ElseIf 0<≢config.CIDER.make
     :AndIf ~(⊃config.CIDER.make~' ')∊'])'                                  ⍝ User and system commands cannot be checked
     :AndIf 9=⎕NC config.CIDER.parent,'.',config.CIDER.projectSpace          ⍝ Only an open project can be checked
     :AndIf 3≠⎕NC buff←{⍵↑⍨¯1+⌊/⍵⍳' ⍝'}config.CIDER.parent,'.',config.CIDER.projectSpace,'.',config.CIDER.make
         successFlag,←FAILURE
         report,←⊂'"CIDER.make" does not point to a function!'
     :EndIf
 :EndIf
 :If 0=config.CIDER.⎕NC'tests'
     successFlag,←FAILURE
     report,←⊂'"CIDER.tests" is not defined'
 :Else
     :If (⊃config.CIDER.tests)∊'#⎕'
         successFlag,←FAILURE
         report,←⊂'"CIDER.tests" is defined with an absolute path; must be relative to the project (check "make")'
     :ElseIf 0<≢config.CIDER.tests
     :AndIf ~(⊃config.CIDER.tests~' ')∊'])'                                 ⍝ User and system commands cannot be checked
     :AndIf 9=⎕NC config.CIDER.parent,'.',config.CIDER.projectSpace          ⍝ Only an open project can be checked
     :AndIf 3≠⎕NC buff←{⍵↑⍨¯1+⌊/⍵⍳' ⍝'}config.CIDER.parent,'.',config.CIDER.projectSpace,'.',config.CIDER.tests
         successFlag,←FAILURE
         report,←⊂'"CIDER.tests" does not point to a function'
     :EndIf
 :EndIf
 :If 0=config.⎕NC'SYSVARS'
     successFlag,←FAILURE
     report,←⊂'section "SYSVARS" is missing (must define at least "ml" and "io")'
 :Else
     :If 0=config.SYSVARS.⎕NC'ml'
         successFlag,←FAILURE
         report,←⊂'"SYSVARS.ml" is not defined'
     :EndIf
     :If 0=config.SYSVARS.⎕NC'io'
         successFlag,←FAILURE
         report,←⊂'"SYSVARS.io" is not defined'
     :EndIf
 :EndIf
 successFlag←∧/successFlag
 msg←1↓⊃,/'; '∘,¨report
⍝Done⍝
