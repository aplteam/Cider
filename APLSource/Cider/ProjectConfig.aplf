 {r}←{editFlag}ProjectConfig path;filename;ns;orig;flag;edit;data;msg;rc;ref;folder
⍝ Puts the contents of the file cider.config in "path" into the editor, or returns them (see `editFlag`).
⍝ If `editFlag` is 0 it's running in read-only mode.
⍝ The result depends on `editFlag`
⍝ * If the user is allowed to edit the configuration (editFlag←→1) a 1 is returned in case the file was modified
⍝   and saved, 0 in case nothing was changed, and ¯1 in case the user cancelled. Deleting the contents of the
⍝   edit window, or declining to save the changes, is treated as cancellation.
⍝ * If editFlag←→0 the configuration is returned as a simple text matrix
 r←0                 ⍝ 0 = no action required ⋄ 1 = save data ⋄ ¯1 = cancelled by user
 editFlag←{0<⎕NC ⍵:⍎⍵ ⋄ 0}'editFlag'
 :If '['∊path
     folder←GetFolderFromAlias2 path
     ('Alias "',path,'" not found')Assert 0<≢folder
     path←folder
 :EndIf
 :If ConfigFilename{⍺≡⎕C(-≢⍺)↑⍵}path
 :AndIf (¯1↑(-≢ConfigFilename)↓path)∊'/\'
     filename←path
 :Else
     filename←path,'/cider.config'
 :EndIf
 ('Does not exist: "',filename,'"')Assert F.Exists filename
 ref←⍎(1+'⎕'=⊃⊃⎕XSI)⊃'#' '⎕SE'
 ref.⎕Shadow'edit'
 ns←⍎'edit'ref.⎕NS''
 :If editFlag
 :AndIf CheckJsonSyntax⊃F.NGET filename 1
     MassageConfig filename                ⍝ Adds missing entries, but only when the file may be changed anyway
 :EndIf
 orig←ns.cider_config←⊃F.NGET filename 1
 ⍝ The file might have been edited with an external editor and carry a mistake: tell the user
 :If ~CheckJsonSyntax ns.cider_config
     1 PrintToSession'*** Warning: ',filename,' is not valid JSON5'
 :Else
     (rc msg)←PerformConfigChecks ⎕JSON⍠('Dialect' 'JSON5')('Compact' 0)⊣1↓∊(⎕UCS 10),¨⊆ns.cider_config
     :If ~rc
         1 PrintToSession'*** Warning: ',filename,': ',msg
     :EndIf
 :EndIf
 :If editFlag
     flag←0      ⍝ Controls the :Repeat loop
     :Repeat
         ns.⎕ED'cider_config'
         :If orig≢ns.cider_config
             :If 0=≢(∊ns.cider_config)~' '
                 r←¯1 ⍝ Cancelled by user
                 flag←1
             :ElseIf ~CheckJsonSyntax ns.cider_config
                 :If ~1 C.YesOrNo'JsonSyntaxProblem@The JSON is syntactially incorrect. Would you like to try again? (no=changes are lost)'
                     flag←1
                     r←¯1 ⍝ Cancelled by user
                 :EndIf
             :Else
                 data←⎕JSON⍠('Dialect' 'JSON5')('Compact' 0)⊣1↓∊(⎕UCS 10),¨⊆ns.cider_config
                 (rc msg)←PerformConfigChecks data
                 :If ~rc
                     :If ~1 C.YesOrNo'JsonCheckFailed@',msg,'. Try again? (no=changes are lost)'
                         flag←1
                         r←¯1 ⍝ Cancelled by user
                     :EndIf
                 :Else
                     :If 1 C.YesOrNo'JsonSaveChanges@Would you like to save your changes?'
                         data WriteProjectConfig filename
                         r←flag←1
                     :Else
                         flag←1
                         r←¯1 ⍝ Cancelled by user
                     :EndIf
                 :EndIf
             :EndIf
         :Else
             flag←1
         :EndIf
     :Until flag
 :Else
     r←↑ns.cider_config
 :EndIf
