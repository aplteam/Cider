 r←Initial_UC_NuGet ps
 :If 0=⎕NC'∆DotNetIsAvailable'
     ∆DotNetIsAvailable←IsDotNetAvailable
 :EndIf
 :If 0=⎕NC'∆ExecNuGetTest'
     :If ~ps.batchFlag
     :AndIf ~∨/' cider_fns=Test_UC_NuGet_'⍷(∊' ',¨2 ⎕NQ #'GetCommandLineArgs')~'"'
         ∆ExecNuGetTest←CommTools.YesOrNo'Do you want to execute NuGet-related test cases?'
     :Else
         ∆ExecNuGetTest←1
     :EndIf
 :EndIf
 r←∆ExecNuGetTest
⍝Done
