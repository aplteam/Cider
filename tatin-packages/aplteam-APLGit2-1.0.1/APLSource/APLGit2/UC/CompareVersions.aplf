 {msg}←CompareVersions(space folder args);y;obj;till;buff;max;hash1;hash2;ind;hashes;filename;filename1;filename2;exe;name;project
⍝ Desc: Compares two versions of a file or an APL object
⍝ Parse: 1-2 -project= -use= -files
⍝ Project: 0
 project←folder
 :If 0<≢space                                      ⍝ Only a project space can qualify a relative APL name
     project←⍕space
 :EndIf
 (obj y)←{0≡⍵:'' ⋄ ⍵}¨args.(_1 _2)
 :If args.files
     exe←''                                        ⍝ The user asked for the filenames, so don't bother the comparison utility
 :Else                                             ⍝ Establish this early: don't let the user select two hashes for nothing
     (exe name)←##.U.EstablishComparisonTool''args.Switch'use'
 :EndIf
 filename←⊃project ##.IdentifyObject obj           ⍝ Relative to the root of the project
 msg←'Not found'
 hashes←till←''
 max←0
 :If 0<≢y
     :If ∨/','∊y
         hashes←y
     :ElseIf 10000000<##.A.ToNum y
         till←##.A.ToNum y
     :Else
         max←##.A.ToNum y
     :EndIf
 :EndIf
 :If 0<≢hashes
     (hash1 hash2)←','(≠⊆⊢)hashes
 :Else
     →(0=≢buff←folder ##.ChangeLog'./',filename)/0
     :If 0<max
         buff←max↑buff
     :ElseIf 0<≢till
         buff⌿⍨←(⊃∘##.A.ToNum¨buff[;3]~¨'-')≥till
     :EndIf
     :Select ≢buff
     :Case 1
         msg←'Only found in one commit: ',⊃buff ⋄ →0
     :Case 2
         (hash1 hash2)←buff[;1]
     :Else
         ind←'Select the two hashes you want to compare' 1 ##.CommTools.Select↓⍕buff
         →(0=≢ind)/0
         'You did not select 2 hashes!'Assert 2=≢ind
         (hash1 hash2)←buff[ind;1]
     :EndSelect
 :EndIf
 (filename1 filename2 hash1 hash2)←project ##.CompareVersions filename hash1 hash2
 :If 0=≢exe
     ⎕←msg←filename1 filename2                     ⍝ No comparison utility: leave the files behind for the user
 :Else
     {}name ##.U.CompareTwoFiles(filename1 filename2)(folder∘##.U.GetCommitCaption¨hash1 hash2)
     msg←'Compared: ',hash1,'-',hash2
     {}##.F.RmDirByForce⊃⎕NPARTS filename1
 :EndIf
