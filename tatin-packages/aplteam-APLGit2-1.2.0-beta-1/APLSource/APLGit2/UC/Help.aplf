 r←level Help Cmd;ref;⎕TRAP;buff;i;list
 r←''
 :Select level
 :Case 0
     list←List ⍬
     :If 0<≢i←⍸(⎕C list.Name)≡¨⊂⎕C Cmd
         r,←⊂']APLGit2.',Cmd,' ',i⊃list.Parse
     :Else
         r,←⊂'There is no help available for ',Cmd
     :EndIf
     :If 'Version'≢Cmd
         r,←''(']APLGit2.',Cmd,' -?? ⍝ Enter this for more information ')
     :EndIf

 :Case 1
     ('No second-level help found for ',Cmd)Assert 0<help.⎕NC Cmd
     r←help⍎Cmd
 :Case 2
     ('No third-level help found for ',Cmd)Assert 0<help.⎕NC Cmd
     :Select ⎕C Cmd
     :CaseList ⎕C¨'Add' ''
         r,←AddProjectOptions 1
         r,←⊂,' '
         r,←AddFileArgOptions
     :CaseList ⎕C¨'ChangeLog' 'CompareVersions' 'Log' 'ShowLastVersionInIndex'
         r,←AddProjectOptions 0
         r,←⊂,' '
         r,←AddFileArgOptions
     :CaseList ⎕C¨'Status' ''
         r←AddProjectOptions 1
         r,←⊂,' '
         r,←'The table returned has up to 4 columns:' ' [;1] Staging area (X)' ' [;2] Working tree (Y)' ' [;3] File names' ' [;4] APL names (if any)'
         r,←⊂,' '
         buff←⊂('Code' 'Meaning')
         buff,←⊂(⍴¨1⊃,buff)⍴¨'-'
         buff,←('(space)' 'Unmodified')('M' 'Modified')('T' 'File type changed (e.g. regular file → symlink)')('A' 'Added')
         buff,←('D' 'Deleted')('R' 'Renamed')('C' 'Copied')('U' 'Updated but unmerged')('?' 'Untracked (only in XY as ??)')('!' 'Ignored (only in XY as !!)')
         r,←↓⍕↑buff
     :Else
         r,←AddProjectOptions 0
     :EndSelect

 :EndSelect
