 {noofBytes}←CompareCommits_(list branch1 branch2 folder currentBranch hash1 hash2 filename1 filename2 space);thisFile;extension;wsName;header;buff1;rc;more;buff2;name;header2;header1;row;op;oldFile
 noofBytes←0
 list←((⊃¨(' '~⍨¨list[;2]))∊'ADM?')⌿list ⍝ Suppress copies and renames
 :For row :In ⍳≢list
     (op thisFile oldFile)←list[row;2 3 4]   ⍝ `oldFile` differs from `thisFile` only after a rename
     extension←⎕C 3⊃⎕NPARTS thisFile
     :If (⊂extension)∊ListOfDyalogFilesExtensions
         wsName←''
         :If ⎕NEXISTS folder,'/',thisFile        ⍝ Link cannot name a file that is gone
             wsName←space GetItemName folder,'/',thisFile
             ('Could not establish APL name for ',folder,'/',thisFile)Assert 0<≢wsName
         :EndIf
         :If (,'.')≡,hash1
             :If ⎕NEXISTS folder,'/',thisFile
                 buff1←⊃⎕NGET(folder,'/',thisFile)1
             :Else
                 buff1←,⊂'>>> Not available <<<'   ⍝ Deleted, whether that is staged or not
             :EndIf
         :Else
             ⍝ A commit knows a file renamed in the working area only under its old name:
             (rc more buff1)←folder U.RunGitCommand('show  --raw ',hash1,':',oldFile)
             :If rc=128
             :AndIf op∊'AD?'
                 buff1←,⊂'>>> Not available <<<'
             :ElseIf 0≠rc
                 ('Cannot read ',oldFile,' from ',hash1,'; RC=',(⍕rc),' ',more)Assert 0
             :EndIf
         :EndIf
         (rc more buff2)←folder U.RunGitCommand('show  --raw ',hash2,':',oldFile)
         :If rc=128
         :AndIf op∊'AD?'
             buff2←,⊂'>>> Not available <<<'
         :ElseIf 0≠rc
             ('Cannot read ',oldFile,' from ',hash2,'; RC=',(⍕rc),' ',more)Assert 0
         :EndIf
         :If 0=≢wsName
             wsName←thisFile                     ⍝ The file is gone, so it has no APL name: show its path
         :EndIf
         header1←↓U.Box(('⌹',[1]'⌹',,[0.5]wsName),[1]'⌹'),'⌹'
         header2←↓U.Box(('⌹',[1]'⌹',,[0.5]wsName),[1]'⌹'),'⌹'
         buff1←header1{⍺{⍺,⍵}⍣(0<≢⍵)⊣⍵}buff1
         buff2←header2{⍺{⍺,⍵}⍣(0<≢⍵)⊣⍵}buff2
     :Else
         name←thisFile
         header←↓U.Box(('⌹',[1]'⌹',,[0.5]name),[1]'⌹'),'⌹'
         buff1←⊂'*** File ',((0<≢extension)/'type '),'ignored: ',name{0=≢⍵:⍺ ⋄ ⍵}extension
         buff2←⊂'*** File ',((0<≢extension)/'type '),'ignored: ',name{0=≢⍵:⍺ ⋄ ⍵}extension
     :EndIf
     :If buff1≢buff2
         (⊂buff1)⎕NPUT filename1 2
         (⊂buff2)⎕NPUT filename2 2
         noofBytes+←⌈/{+/≢¨⍵}¨buff1 buff2
     :EndIf
 :EndFor
⍝Done
