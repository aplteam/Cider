 {r}←RunProcess(EXE command);cmd;i;op;p;pfn;re;ro;rtc;t;⎕IO;⎕USING;tfn;buff;dmx;dotnet;exception;CleanErr
⍝ Runs EXE and returns a namespace with all sorts of variables, among them StdOut and StdErr.
⍝ Cannot run in elevated mode because for that we would need to set i.Verb to 'runas' which
⍝ we can't because "UseShellEexecute" must be set to 1 for this which we can't because we must
⍝ redirect StdOut and StdErr, something we can only do with "UseShellExecute←0"
⍝ ⍵[0] ←→ Executable
⍝ ⍵[1] ←→ Argument
⍝ `StdOut` is a vector of lines.
⍝ `StdErr` is *always* a simple character vector with CR as the only line separator; every
⍝ branch below must stick to that, so run anything that comes from outside through `CleanErr`.
⍝ Callers rely on it: they check `StdErr` for a leading "fatal:", catenate it into messages
⍝ of their own and enclose it as a single line, and none of that survives a vector of lines.
 ⎕IO←0
 r←⎕NS''
 r.⎕IO←1
 CleanErr←{
⍝ Canonical form of an error message. Takes a character vector or a vector of lines.
     t←{1<|≡⍵:1↓∊(⎕UCS 13),¨⍵ ⋄ ,⍵}⍵          ⍝ A vector of lines becomes CR-separated text
     t←' '@((⎕UCS 9)∘=)t                       ⍝ Tabs → blanks
     t←(⎕UCS 13)@(∊∘(⎕UCS 13 10))t             ⍝ CR as well as LF → CR, so CRLF becomes CR CR
     t←t/⍨~(t=⎕UCS 13)∧0,¯1↓t=⎕UCS 13          ⍝ ... and CR CR collapses back into a single CR
     t/⍨{(∨\⍵)∧⌽∨\⌽⍵}t≠⎕UCS 13                 ⍝ No leading or trailing separators
 }
 dotnet←2250⌶0
 :If 1=1⊃dotnet                  ⍝ Bridge successfully loaded?
     :Select 0⊃dotnet
     :Case 1            ⍝ .NET
         ⎕USING←'System' 'System.IO' 'System.Diagnostics,System.Diagnostics.Process'
     :Case 2            ⍝ .NET Framework
         ⎕USING←'System' 'System.IO' 'System.Diagnostics,System.dll'
     :EndSelect
     p←⎕NEW Process
     i←p.StartInfo
     i.FileName←EXE
     i.Arguments←command
     i.RedirectStandardOutput←1
     i.RedirectStandardInput←1
     i.RedirectStandardError←1
     i.UseShellExecute←0
     i.CreateNoWindow←1
     :Trap 90
         {}p.Start ⍬
     :Else
         dmx←⎕DMX
         :If ∨/'Check ⎕EXCEPTION for details'⍷dmx.Message
             exception←{(⎕UCS 13)@(⍸⍵=⎕UCS 10)⊢⍵}⍕⎕EXCEPTION
             :If ∨/': The system cannot find the file specified'⍷exception
                 r.ExitCode←127 ⋄ r.StdOut←'' ⋄ r.StdErr←'It appears that Git is not installed'
                 :Return
             :Else
                 ('.NET error: ',(⎕UCS 13),exception)⎕SIGNAL 11
             :EndIf
         :Else
             dmx.Message ⎕SIGNAL dmx.EN
         :EndIf
     :EndTrap
     re←⎕NEW StreamReader p.StandardError.BaseStream
     ro←⎕NEW StreamReader p.StandardOutput.BaseStream
     t←r{⍺.StdErr←⍵.ReadToEnd}&re
     r.StdOut←ro.ReadToEnd
     op←{6::0 ⋄ z←⍺⍺ ⍵}
     {}p.WaitForExit op ⍬
     {}⎕TSYNC op t
     r.ExitCode←p.ExitCode
     rtc←{' '@((⎕UCS 9)∘=)⍵}
     :If 0<≢r.StdOut
         :If ∨/(⎕UCS 10 13)⍷r.StdOut
             pfn←{(⎕UCS 10 13)A.Split ⍵}
         :Else
             pfn←{(⎕UCS 10)A.Split ⍵}
         :EndIf
         r.StdOut←pfn rtc r.StdOut
     :EndIf
     r.StdErr←CleanErr r.StdErr
     :If 1<|≡r.StdOut
         r.StdOut←(-+/∧\0=⌽≢¨r.StdOut)↓r.StdOut  ⍝ Remove trailing empty lines
     :EndIf
 :Else
     '.NET is not available but required on Windows'Assert'Win'≢A.GetOperatingSystem ⍬
     ⎕IO←1
     r.ExitCode←0
     r.StdErr←r.StdOut←''
     tfn←##.F.GetTempFilename2'APLGit'   ⍝ Temp FileName
     cmd←EXE,' ',command,' 2>"',tfn,'"'
     :Trap 11
         buff←⎕SH cmd
     :Else
         dmx←⎕DMX
         r.ExitCode←1
         r.StdErr←CleanErr dmx.Message
         :If ∨/'code 127 '⍷dmx.Message,' '
             r.ExitCode←127
             r.StdErr←'It appears that Git is not installed'
         :ElseIf ∨/'code 128 '⍷dmx.Message,' '
             r.ExitCode←128
         :EndIf
         ##.F.DeleteFile tfn                   ⍝ ⎕SH has created it, so it must go even now
         :Return
     :EndTrap
     r.StdOut←{'UTF-8'⎕UCS ⎕UCS ⍵}¨buff
     r.StdErr←CleanErr{22::'' ⋄ ⊃⎕NGET ⍵ 1}tfn
     ##.F.DeleteFile tfn
 :EndIf
